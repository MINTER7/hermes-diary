# Example only; setup_diary.py writes the real <HERMES_HOME>/diary/config.env.
# This is trusted Bash configuration. Never publish the real file or its backup.
# New profile defaults: local, English, UTC, weather off, no schedule.
DIARY_DIR="${HERMES_HOME:-$HOME/.hermes}/diary/data"
TIMEZONE=UTC
DEFAULT_CITY=''
LANGUAGE=en
TEMPERATURE_UNIT=C
WEATHER_ENABLED=false
DELIVERY=local
SCHEDULE_AT=23:59
# Secrets are provided through secure HERMES_DIARY_* input and persisted locally.
TELEGRAM_BOT_TOKEN=''
TELEGRAM_CHANNEL_ID=''
WEBHOOK_URL=''
WEBHOOK_TOKEN=''
# Use setup_diary.py configure --schedule to enable cron; this file alone does not.
